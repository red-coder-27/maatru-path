# Template configuration for Serverpod passwords.
# Copy this file to `maatru_path_server/config/passwords.yaml` and set your credentials.
# Note: config/passwords.yaml is ignored by Git and should NEVER be committed.

development:
  database: 'your-development-db-password'
  redis: 'your-development-redis-password'
  serviceSecret: 'your-development-service-secret'
  emailSecretHashPepper: 'your-development-email-pepper'
  jwtHmacSha512PrivateKey: 'your-development-jwt-hmac-key'
  jwtRefreshTokenHashPepper: 'your-development-jwt-refresh-pepper'

test:
  database: 'your-test-db-password'
  redis: 'your-test-redis-password'
  emailSecretHashPepper: 'your-test-email-pepper'
  jwtHmacSha512PrivateKey: 'your-test-jwt-hmac-key'
  jwtRefreshTokenHashPepper: 'your-test-jwt-refresh-pepper'

staging:
  database: 'your-staging-db-password'
  serviceSecret: 'your-staging-service-secret'
  emailSecretHashPepper: 'your-staging-email-pepper'
  jwtHmacSha512PrivateKey: 'your-staging-jwt-hmac-key'
  jwtRefreshTokenHashPepper: 'your-staging-jwt-refresh-pepper'

production:
  database: 'your-production-db-password'
  serviceSecret: 'your-production-service-secret'
  emailSecretHashPepper: 'your-production-email-pepper'
  jwtHmacSha512PrivateKey: 'your-production-jwt-hmac-key'
  jwtRefreshTokenHashPepper: 'your-production-jwt-refresh-pepper'
